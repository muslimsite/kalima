{"sura":113,"title":"Аль-Фаляк","ayahs":[{"n":1,"juz":30,"ru":"Скажи: «Прибегаю к защите Господа рассвета","w":["قُلْ","أَعُوذُ","بِرَبِّ","الْفَلَقِ"]},{"n":2,"juz":30,"ru":"от зла того, что Он сотворил,","w":["مِن","شَرِّ","مَا","خَلَقَ"]},{"n":3,"juz":30,"ru":"от зла мрака, когда он наступает,","w":["وَمِن","شَرِّ","غَاسِقٍ","إِذَا","وَقَبَ"]},{"n":4,"juz":30,"ru":"от зла колдуний, поплевывающих на узлы,","w":["وَمِن","شَرِّ","النَّفَّاثَاتِ","فِي","الْعُقَدِ"]},{"n":5,"juz":30,"ru":"от зла завистника, когда он завидует».","w":["وَمِن","شَرِّ","حَاسِدٍ","إِذَا","حَسَدَ"]}]}