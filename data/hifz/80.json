{"sura":80,"title":"Абаса","ayahs":[{"n":1,"juz":30,"ru":"Он нахмурился и отвернулся,","w":["عَبَسَ","وَتَوَلَّىٰ"]},{"n":2,"juz":30,"ru":"потому что к нему подошел слепой.","w":["أَن","جَاءَهُ","الْأَعْمَىٰ"]},{"n":3,"juz":30,"ru":"Откуда тебе знать? Возможно, он бы очистился","w":["وَمَا","يُدْرِيكَ","لَعَلَّهُ","يَزَّكَّىٰ"]},{"n":4,"juz":30,"ru":"или помянул бы наставление, и поминание принесло бы ему пользу.","w":["أَوْ","يَذَّكَّرُ","فَتَنفَعَهُ","الذِّكْرَىٰ"]},{"n":5,"juz":30,"ru":"Тому, кто решил, что он ни в чем не нуждается,","w":["أَمَّا","مَنِ","اسْتَغْنَىٰ"]},{"n":6,"juz":30,"ru":"ты уделяешь внимание,","w":["فَأَنتَ","لَهُ","تَصَدَّىٰ"]},{"n":7,"juz":30,"ru":"Что же будет тебе, если он не очистится?","w":["وَمَا","عَلَيْكَ","أَلَّا","يَزَّكَّىٰ"]},{"n":8,"juz":30,"ru":"А того, кто приходит к тебе со рвением","w":["وَأَمَّا","مَن","جَاءَكَ","يَسْعَىٰ"]},{"n":9,"juz":30,"ru":"и страшится Аллаха,","w":["وَهُوَ","يَخْشَىٰ"]},{"n":10,"juz":30,"ru":"ты оставляешь без внимания.","w":["فَأَنتَ","عَنْهُ","تَلَهَّىٰ"]},{"n":11,"juz":30,"ru":"Но нет! Это есть Назидание,","w":["كَلَّا","إِنَّهَا","تَذْكِرَةٌ"]},{"n":12,"juz":30,"ru":"и пусть помянет его всякий желающий.","w":["فَمَن","شَاءَ","ذَكَرَهُ"]},{"n":13,"juz":30,"ru":"Оно записано в свитках почитаемых,","w":["فِي","صُحُفٍ","مُّكَرَّمَةٍ"]},{"n":14,"juz":30,"ru":"вознесенных и очищенных,","w":["مَّرْفُوعَةٍ","مُّطَهَّرَةٍ"]},{"n":15,"juz":30,"ru":"в руках посланцев","w":["بِأَيْدِي","سَفَرَةٍ"]},{"n":16,"juz":30,"ru":"благородных и покорных.","w":["كِرَامٍ","بَرَرَةٍ"]},{"n":17,"juz":30,"ru":"Да сгинет человек! Как же он неблагодарен!","w":["قُتِلَ","الْإِنسَانُ","مَا","أَكْفَرَهُ"]},{"n":18,"juz":30,"ru":"Из чего Он сотворил его?","w":["مِنْ","أَيِّ","شَيْءٍ","خَلَقَهُ"]},{"n":19,"juz":30,"ru":"Он сотворил его из капли и соразмерил (или предопределил стадии его развития),","w":["مِن","نُّطْفَةٍ","خَلَقَهُ","فَقَدَّرَهُ"]},{"n":20,"juz":30,"ru":"потом облегчил ему путь,","w":["ثُمَّ","السَّبِيلَ","يَسَّرَهُ"]},{"n":21,"juz":30,"ru":"потом умертвил его и поместил в могилу.","w":["ثُمَّ","أَمَاتَهُ","فَأَقْبَرَهُ"]},{"n":22,"juz":30,"ru":"Потом, когда пожелает, Он воскресит его.","w":["ثُمَّ","إِذَا","شَاءَ","أَنشَرَهُ"]},{"n":23,"juz":30,"ru":"Но нет! Он не выполняет того, что Он приказал ему.","w":["كَلَّا","لَمَّا","يَقْضِ","مَا","أَمَرَهُ"]},{"n":24,"juz":30,"ru":"Пусть посмотрит человек на свое пропитание!","w":["فَلْيَنظُرِ","الْإِنسَانُ","إِلَىٰ","طَعَامِهِ"]},{"n":25,"juz":30,"ru":"Мы проливаем обильные ливни,","w":["أَنَّا","صَبَبْنَا","الْمَاءَ","صَبًّا"]},{"n":26,"juz":30,"ru":"затем рассекаем землю трещинами","w":["ثُمَّ","شَقَقْنَا","الْأَرْضَ","شَقًّا"]},{"n":27,"juz":30,"ru":"и взращиваем на ней зерна,","w":["فَأَنبَتْنَا","فِيهَا","حَبًّا"]},{"n":28,"juz":30,"ru":"виноград и люцерну,","w":["وَعِنَبًا","وَقَضْبًا"]},{"n":29,"juz":30,"ru":"маслины и финиковые пальмы,","w":["وَزَيْتُونًا","وَنَخْلًا"]},{"n":30,"juz":30,"ru":"сады густые (или с могучими деревьями),","w":["وَحَدَائِقَ","غُلْبًا"]},{"n":31,"juz":30,"ru":"фрукты и травы","w":["وَفَاكِهَةً","وَأَبًّا"]},{"n":32,"juz":30,"ru":"на пользу вам и вашей скотине.","w":["مَّتَاعًا","لَّكُمْ","وَلِأَنْعَامِكُمْ"]},{"n":33,"juz":30,"ru":"Когда же раздастся Оглушительный глас,","w":["فَإِذَا","جَاءَتِ","الصَّاخَّةُ"]},{"n":34,"juz":30,"ru":"в тот день человек бросит своего брата,","w":["يَوْمَ","يَفِرُّ","الْمَرْءُ","مِنْ","أَخِيهِ"]},{"n":35,"juz":30,"ru":"свою мать и своего отца,","w":["وَأُمِّهِ","وَأَبِيهِ"]},{"n":36,"juz":30,"ru":"свою жену и своих сыновей,","w":["وَصَاحِبَتِهِ","وَبَنِيهِ"]},{"n":37,"juz":30,"ru":"ибо у каждого человека своих забот будет сполна.","w":["لِكُلِّ","امْرِئٍ","مِّنْهُمْ","يَوْمَئِذٍ","شَأْنٌ","يُغْنِيهِ"]},{"n":38,"juz":30,"ru":"В тот день одни лица будут сиять,","w":["وُجُوهٌ","يَوْمَئِذٍ","مُّسْفِرَةٌ"]},{"n":39,"juz":30,"ru":"смеяться и ликовать.","w":["ضَاحِكَةٌ","مُّسْتَبْشِرَةٌ"]},{"n":40,"juz":30,"ru":"На других же лицах в тот день будет прах,","w":["وَوُجُوهٌ","يَوْمَئِذٍ","عَلَيْهَا","غَبَرَةٌ"]},{"n":41,"juz":30,"ru":"покрывающий их мраком.","w":["تَرْهَقُهَا","قَتَرَةٌ"]},{"n":42,"juz":30,"ru":"Это будут неверующие грешники.","w":["أُولَٰئِكَ","هُمُ","الْكَفَرَةُ","الْفَجَرَةُ"]}]}