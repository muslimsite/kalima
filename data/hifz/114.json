{"sura":114,"title":"Ан-Нас","ayahs":[{"n":1,"juz":30,"ru":"Скажи: «Прибегаю к защите Господа людей,","w":["قُلْ","أَعُوذُ","بِرَبِّ","النَّاسِ"]},{"n":2,"juz":30,"ru":"Царя людей,","w":["مَلِكِ","النَّاسِ"]},{"n":3,"juz":30,"ru":"Бога людей,","w":["إِلَٰهِ","النَّاسِ"]},{"n":4,"juz":30,"ru":"от зла искусителя отступающего (или сжимающегося) при поминании Аллаха,","w":["مِن","شَرِّ","الْوَسْوَاسِ","الْخَنَّاسِ"]},{"n":5,"juz":30,"ru":"который наущает в груди людей","w":["الَّذِي","يُوَسْوِسُ","فِي","صُدُورِ","النَّاسِ"]},{"n":6,"juz":30,"ru":"и бывает из джиннов и людей».","w":["مِنَ","الْجِنَّةِ","وَالنَّاسِ"]}]}