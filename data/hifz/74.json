{"sura":74,"title":"Аль-Муддассир","ayahs":[{"n":1,"juz":29,"ru":"О завернувшийся!","w":["يَا أَيُّهَا","الْمُدَّثِّرُ"]},{"n":2,"juz":29,"ru":"Встань и увещевай!","w":["قُمْ","فَأَنذِرْ"]},{"n":3,"juz":29,"ru":"Господа своего величай!","w":["وَرَبَّكَ","فَكَبِّرْ"]},{"n":4,"juz":29,"ru":"Одежды свои очищай!","w":["وَثِيَابَكَ","فَطَهِّرْ"]},{"n":5,"juz":29,"ru":"Скверны (идолов) сторонись!","w":["وَالرُّجْزَ","فَاهْجُرْ"]},{"n":6,"juz":29,"ru":"Не оказывай милости, чтобы получить большее!","w":["وَلَا","تَمْنُن","تَسْتَكْثِرُ"]},{"n":7,"juz":29,"ru":"Ради Господа твоего будь терпелив!","w":["وَلِرَبِّكَ","فَاصْبِرْ"]},{"n":8,"juz":29,"ru":"Когда же протрубят в рог,","w":["فَإِذَا","نُقِرَ","فِي","النَّاقُورِ"]},{"n":9,"juz":29,"ru":"то день тот будет Днем тяжким,","w":["فَذَٰلِكَ","يَوْمَئِذٍ","يَوْمٌ","عَسِيرٌ"]},{"n":10,"juz":29,"ru":"нелегким для неверующих.","w":["عَلَى","الْكَافِرِينَ","غَيْرُ","يَسِيرٍ"]},{"n":11,"juz":29,"ru":"Оставь Меня с тем, кого Я сотворил одиноким,","w":["ذَرْنِي","وَمَنْ","خَلَقْتُ","وَحِيدًا"]},{"n":12,"juz":29,"ru":"даровал ему большое богатство","w":["وَجَعَلْتُ","لَهُ","مَالًا","مَّمْدُودًا"]},{"n":13,"juz":29,"ru":"и сыновей, которые находились рядом с ним,","w":["وَبَنِينَ","شُهُودًا"]},{"n":14,"juz":29,"ru":"и распростер перед ним этот мир полностью.","w":["وَمَهَّدتُّ","لَهُ","تَمْهِيدًا"]},{"n":15,"juz":29,"ru":"После всего этого он желает, чтобы Я добавил ему.","w":["ثُمَّ","يَطْمَعُ","أَنْ","أَزِيدَ"]},{"n":16,"juz":29,"ru":"Но нет! Он упрямо отрицает Наши знамения.","w":["كَلَّا ۖ","إِنَّهُ","كَانَ","لِآيَاتِنَا","عَنِيدًا"]},{"n":17,"juz":29,"ru":"Я возложу на него подъем (восхождение на гору в Аду).","w":["سَأُرْهِقُهُ","صَعُودًا"]},{"n":18,"juz":29,"ru":"Он подумал и рассчитал.","w":["إِنَّهُ","فَكَّرَ","وَقَدَّرَ"]},{"n":19,"juz":29,"ru":"Да сгинет он! Как он рассчитал?!","w":["فَقُتِلَ","كَيْفَ","قَدَّرَ"]},{"n":20,"juz":29,"ru":"Да сгинет он еще раз! Как он рассчитал?!","w":["ثُمَّ","قُتِلَ","كَيْفَ","قَدَّرَ"]},{"n":21,"juz":29,"ru":"Затем он задумался.","w":["ثُمَّ","نَظَرَ"]},{"n":22,"juz":29,"ru":"Затем он нахмурился и насупился.","w":["ثُمَّ","عَبَسَ","وَبَسَرَ"]},{"n":23,"juz":29,"ru":"Затем он повернулся спиной и возгордился","w":["ثُمَّ","أَدْبَرَ","وَاسْتَكْبَرَ"]},{"n":24,"juz":29,"ru":"и сказал: «Это - не что иное, как пересказанное колдовство.","w":["فَقَالَ","إِنْ","هَٰذَا","إِلَّا","سِحْرٌ","يُؤْثَرُ"]},{"n":25,"juz":29,"ru":"Это - не что иное, как слова человека».","w":["إِنْ","هَٰذَا","إِلَّا","قَوْلُ","الْبَشَرِ"]},{"n":26,"juz":29,"ru":"Я брошу его в Преисподнюю.","w":["سَأُصْلِيهِ","سَقَرَ"]},{"n":27,"juz":29,"ru":"Откуда ты мог знать, что такое Преисподняя?","w":["وَمَا","أَدْرَاكَ","مَا","سَقَرُ"]},{"n":28,"juz":29,"ru":"Она не щадит и не оставляет.","w":["لَا","تُبْقِي","وَلَا","تَذَرُ"]},{"n":29,"juz":29,"ru":"Она сжигает кожу.","w":["لَوَّاحَةٌ","لِّلْبَشَرِ"]},{"n":30,"juz":29,"ru":"Их (ангелов) над ней - девятнадцать.","w":["عَلَيْهَا","تِسْعَةَ","عَشَرَ"]},{"n":31,"juz":29,"ru":"Стражами Огня мы сделали только ангелов, а количество их сделали искушением для неверующих, чтобы удостоверились те, кому было даровано Писание, чтобы усилилась вера у верующих, чтобы не сомневались те, кому было даровано Писание, и верующие, и чтобы спросили те, чьи сердца поражены недугом, и неверующие: «Что хотел Аллах этой притчей?». Так Аллах вводит в заблуждение, кого пожелает, и ведет прямым путем, кого пожелает. Воинство твоего Господа не знает никто, кроме Него. Это же - не что иное, как Напоминание для человечества.","w":["وَمَا","جَعَلْنَا","أَصْحَابَ","النَّارِ","إِلَّا","مَلَائِكَةً ۙ","وَمَا","جَعَلْنَا","عِدَّتَهُمْ","إِلَّا","فِتْنَةً","لِّلَّذِينَ","كَفَرُوا","لِيَسْتَيْقِنَ","الَّذِينَ","أُوتُوا","الْكِتَابَ","وَيَزْدَادَ","الَّذِينَ","آمَنُوا","إِيمَانًا ۙ","وَلَا","يَرْتَابَ","الَّذِينَ","أُوتُوا","الْكِتَابَ","وَالْمُؤْمِنُونَ ۙ","وَلِيَقُولَ","الَّذِينَ","فِي","قُلُوبِهِم","مَّرَضٌ","وَالْكَافِرُونَ","مَاذَا","أَرَادَ","اللَّهُ","بِهَٰذَا","مَثَلًا ۚ","كَذَٰلِكَ","يُضِلُّ","اللَّهُ","مَن","يَشَاءُ","وَيَهْدِي","مَن","يَشَاءُ ۚ","وَمَا","يَعْلَمُ","جُنُودَ","رَبِّكَ","إِلَّا","هُوَ ۚ","وَمَا","هِيَ","إِلَّا","ذِكْرَىٰ","لِلْبَشَرِ"]},{"n":32,"juz":29,"ru":"О да! Клянусь луной!","w":["كَلَّا","وَالْقَمَرِ"]},{"n":33,"juz":29,"ru":"Клянусь ночью, когда она отступает!","w":["وَاللَّيْلِ","إِذْ","أَدْبَرَ"]},{"n":34,"juz":29,"ru":"Клянусь зарей, когда она занимается!","w":["وَالصُّبْحِ","إِذَا","أَسْفَرَ"]},{"n":35,"juz":29,"ru":"Это есть одно из величайших явлений,","w":["إِنَّهَا","لَإِحْدَى","الْكُبَرِ"]},{"n":36,"juz":29,"ru":"предостерегающее человечество -","w":["نَذِيرًا","لِّلْبَشَرِ"]},{"n":37,"juz":29,"ru":"тех из вас, кто желает продвигаться вперед благодаря праведным деяниям или отступать назад, совершая грехи.","w":["لِمَن","شَاءَ","مِنكُمْ","أَن","يَتَقَدَّمَ","أَوْ","يَتَأَخَّرَ"]},{"n":38,"juz":29,"ru":"Каждый человек является заложником того, что он приобрел,","w":["كُلُّ","نَفْسٍ","بِمَا","كَسَبَتْ","رَهِينَةٌ"]},{"n":39,"juz":29,"ru":"кроме людей правой стороны.","w":["إِلَّا","أَصْحَابَ","الْيَمِينِ"]},{"n":40,"juz":29,"ru":"В Райских садах они будут расспрашивать друг друга","w":["فِي","جَنَّاتٍ","يَتَسَاءَلُونَ"]},{"n":41,"juz":29,"ru":"о грешниках.","w":["عَنِ","الْمُجْرِمِينَ"]},{"n":42,"juz":29,"ru":"Что привело вас в Преисподнюю?","w":["مَا","سَلَكَكُمْ","فِي","سَقَرَ"]},{"n":43,"juz":29,"ru":"Они скажут: «Мы не были в числе тех, которые совершали намаз.","w":["قَالُوا","لَمْ","نَكُ","مِنَ","الْمُصَلِّينَ"]},{"n":44,"juz":29,"ru":"Мы не кормили бедняков.","w":["وَلَمْ","نَكُ","نُطْعِمُ","الْمِسْكِينَ"]},{"n":45,"juz":29,"ru":"Мы погружались в словоблудие вместе с погружавшимися.","w":["وَكُنَّا","نَخُوضُ","مَعَ","الْخَائِضِينَ"]},{"n":46,"juz":29,"ru":"Мы считали ложью Последний день,","w":["وَكُنَّا","نُكَذِّبُ","بِيَوْمِ","الدِّينِ"]},{"n":47,"juz":29,"ru":"пока к нам не явилась убежденность (смерть)».","w":["حَتَّىٰ","أَتَانَا","الْيَقِينُ"]},{"n":48,"juz":29,"ru":"Заступничество заступников не поможет им.","w":["فَمَا","تَنفَعُهُمْ","شَفَاعَةُ","الشَّافِعِينَ"]},{"n":49,"juz":29,"ru":"Что же с ними? Почему они отворачиваются от Напоминания,","w":["فَمَا","لَهُمْ","عَنِ","التَّذْكِرَةِ","مُعْرِضِينَ"]},{"n":50,"juz":29,"ru":"словно напуганные ослы,","w":["كَأَنَّهُمْ","حُمُرٌ","مُّسْتَنفِرَةٌ"]},{"n":51,"juz":29,"ru":"бегущие от стрелка (или льва)?","w":["فَرَّتْ","مِن","قَسْوَرَةٍ"]},{"n":52,"juz":29,"ru":"Но ведь каждый из них желает получить развернутые свитки.","w":["بَلْ","يُرِيدُ","كُلُّ","امْرِئٍ","مِّنْهُمْ","أَن","يُؤْتَىٰ","صُحُفًا","مُّنَشَّرَةً"]},{"n":53,"juz":29,"ru":"Но нет! Они не боятся Последней жизни.","w":["كَلَّا ۖ","بَل","لَّا","يَخَافُونَ","الْآخِرَةَ"]},{"n":54,"juz":29,"ru":"Но нет! Это есть Назидание.","w":["كَلَّا","إِنَّهُ","تَذْكِرَةٌ"]},{"n":55,"juz":29,"ru":"Помянет его тот, кто захочет.","w":["فَمَن","شَاءَ","ذَكَرَهُ"]},{"n":56,"juz":29,"ru":"Но они не помянут его, если этого не пожелает Аллах. Он - Тот, Кто достоин страха и способен на прощение.","w":["وَمَا","يَذْكُرُونَ","إِلَّا","أَن","يَشَاءَ","اللَّهُ ۚ","هُوَ","أَهْلُ","التَّقْوَىٰ","وَأَهْلُ","الْمَغْفِرَةِ"]}]}