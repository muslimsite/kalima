{"sura":88,"title":"Аль-Гашия","ayahs":[{"n":1,"juz":30,"ru":"Дошел ли до тебя рассказ о Покрывающем (Дне воскресения)?","w":["هَلْ","أَتَاكَ","حَدِيثُ","الْغَاشِيَةِ"]},{"n":2,"juz":30,"ru":"Одни лица в тот день будут унижены,","w":["وُجُوهٌ","يَوْمَئِذٍ","خَاشِعَةٌ"]},{"n":3,"juz":30,"ru":"изнурены и утомлены.","w":["عَامِلَةٌ","نَّاصِبَةٌ"]},{"n":4,"juz":30,"ru":"Они войдут в Огонь жаркий.","w":["تَصْلَىٰ","نَارًا","حَامِيَةً"]},{"n":5,"juz":30,"ru":"Их будут поить из источника кипящего","w":["تُسْقَىٰ","مِنْ","عَيْنٍ","آنِيَةٍ"]},{"n":6,"juz":30,"ru":"и кормить только ядовитыми колючками,","w":["لَّيْسَ","لَهُمْ","طَعَامٌ","إِلَّا","مِن","ضَرِيعٍ"]},{"n":7,"juz":30,"ru":"от которых не поправляются и которые не утоляют голода.","w":["لَّا","يُسْمِنُ","وَلَا","يُغْنِي","مِن","جُوعٍ"]},{"n":8,"juz":30,"ru":"Другие же лица в тот день будут радостны.","w":["وُجُوهٌ","يَوْمَئِذٍ","نَّاعِمَةٌ"]},{"n":9,"juz":30,"ru":"Они будут довольны своими стараниями","w":["لِّسَعْيِهَا","رَاضِيَةٌ"]},{"n":10,"juz":30,"ru":"в Вышних садах.","w":["فِي","جَنَّةٍ","عَالِيَةٍ"]},{"n":11,"juz":30,"ru":"Они не услышат там словоблудия.","w":["لَّا","تَسْمَعُ","فِيهَا","لَاغِيَةً"]},{"n":12,"juz":30,"ru":"Там есть источник текущий.","w":["فِيهَا","عَيْنٌ","جَارِيَةٌ"]},{"n":13,"juz":30,"ru":"Там воздвигнуты ложа,","w":["فِيهَا","سُرُرٌ","مَّرْفُوعَةٌ"]},{"n":14,"juz":30,"ru":"расставлены чаши,","w":["وَأَكْوَابٌ","مَّوْضُوعَةٌ"]},{"n":15,"juz":30,"ru":"разложены подушки,","w":["وَنَمَارِقُ","مَصْفُوفَةٌ"]},{"n":16,"juz":30,"ru":"и разостланы ковры.","w":["وَزَرَابِيُّ","مَبْثُوثَةٌ"]},{"n":17,"juz":30,"ru":"Неужели они не видят, как созданы верблюды,","w":["أَفَلَا","يَنظُرُونَ","إِلَى","الْإِبِلِ","كَيْفَ","خُلِقَتْ"]},{"n":18,"juz":30,"ru":"как вознесено небо,","w":["وَإِلَى","السَّمَاءِ","كَيْفَ","رُفِعَتْ"]},{"n":19,"juz":30,"ru":"как водружены горы,","w":["وَإِلَى","الْجِبَالِ","كَيْفَ","نُصِبَتْ"]},{"n":20,"juz":30,"ru":"как распростерта земля?","w":["وَإِلَى","الْأَرْضِ","كَيْفَ","سُطِحَتْ"]},{"n":21,"juz":30,"ru":"Наставляй же, ведь ты - наставник,","w":["فَذَكِّرْ","إِنَّمَا","أَنتَ","مُذَكِّرٌ"]},{"n":22,"juz":30,"ru":"и ты не властен над ними.","w":["لَّسْتَ","عَلَيْهِم","بِمُصَيْطِرٍ"]},{"n":23,"juz":30,"ru":"А тех, кто отвернется и не уверует,","w":["إِلَّا","مَن","تَوَلَّىٰ","وَكَفَرَ"]},{"n":24,"juz":30,"ru":"Аллах подвергнет величайшим мучениям.","w":["فَيُعَذِّبُهُ","اللَّهُ","الْعَذَابَ","الْأَكْبَرَ"]},{"n":25,"juz":30,"ru":"К Нам они вернутся,","w":["إِنَّ","إِلَيْنَا","إِيَابَهُمْ"]},{"n":26,"juz":30,"ru":"и затем Мы потребуем у них отчета.","w":["ثُمَّ","إِنَّ","عَلَيْنَا","حِسَابَهُم"]}]}