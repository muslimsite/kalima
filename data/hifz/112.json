{"sura":112,"title":"Аль-Ихлас","ayahs":[{"n":1,"juz":30,"ru":"Скажи: «Он - Аллах Единый,","w":["قُلْ","هُوَ","اللَّهُ","أَحَدٌ"]},{"n":2,"juz":30,"ru":"Аллах Самодостаточный.","w":["اللَّهُ","الصَّمَدُ"]},{"n":3,"juz":30,"ru":"Он не родил и не был рожден,","w":["لَمْ","يَلِدْ","وَلَمْ","يُولَدْ"]},{"n":4,"juz":30,"ru":"и нет никого равного Ему».","w":["وَلَمْ","يَكُن","لَّهُ","كُفُوًا","أَحَدٌ"]}]}