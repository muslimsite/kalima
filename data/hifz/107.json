{"sura":107,"title":"Аль-Маун","ayahs":[{"n":1,"juz":30,"ru":"Видел ли ты того, кто считает ложью воздаяние?","w":["أَرَأَيْتَ","الَّذِي","يُكَذِّبُ","بِالدِّينِ"]},{"n":2,"juz":30,"ru":"Это - тот, кто гонит сироту","w":["فَذَٰلِكَ","الَّذِي","يَدُعُّ","الْيَتِيمَ"]},{"n":3,"juz":30,"ru":"и не побуждает накормить бедняка.","w":["وَلَا","يَحُضُّ","عَلَىٰ","طَعَامِ","الْمِسْكِينِ"]},{"n":4,"juz":30,"ru":"Горе молящимся,","w":["فَوَيْلٌ","لِّلْمُصَلِّينَ"]},{"n":5,"juz":30,"ru":"которые небрежны к своим намазам,","w":["الَّذِينَ","هُمْ","عَن","صَلَاتِهِمْ","سَاهُونَ"]},{"n":6,"juz":30,"ru":"которые лицемерят","w":["الَّذِينَ","هُمْ","يُرَاءُونَ"]},{"n":7,"juz":30,"ru":"и отказывают даже в мелочи!","w":["وَيَمْنَعُونَ","الْمَاعُونَ"]}]}